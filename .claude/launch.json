{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "antar-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "D:\\Project\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "antar-frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d D:\\Project\\antar-frontend && set NEXT_PUBLIC_API_URL=http://127.0.0.1:8000&& npm run dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "antar-backend-test",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set ALLOWED_ORIGINS=http://localhost:3000&& D:\\Project\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8001"
      ],
      "port": 8001,
      "autoPort": false
    }
  ]
}