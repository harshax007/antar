# ── Environment Variables for Antar Backend ───────────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git — it's in .gitignore

# ── Catalyst Platform ─────────────────────────────────────────────────────────
CATALYST_PROJECT_ID=your_project_id_here
CATALYST_PROJECT_SECRET=your_project_secret_here
CATALYST_PROJECT_KEY=your_project_key_here
CATALYST_ENV=development                        # or: production

# ── Catalyst Data Store ───────────────────────────────────────────────────────
# No connection string needed — zcatalyst-sdk uses env creds above

# ── Catalyst Stratus ──────────────────────────────────────────────────────────
STRATUS_BUCKET_NAME=antar-files

# ── QuickML LLM Serving (Zoho Catalyst) ───────────────────────────────────────
QUICKML_CLIENT_ID=
QUICKML_CLIENT_SECRET=
QUICKML_LLM_MODEL=Qwen-3.6-Instruct             # Default base model
QUICKML_CHAT_MODEL=GLM-4.7-Flash                # Dedicated fast MoE model for /ask & chat interface
QUICKML_DEFAULT_MODEL=Qwen-3.6-Instruct         # Analytical model for non-chat screens & agents
QUICKML_VISION_MODEL=VL-Qwen3.6-35B-A3B         # Vision-Language model for scanned evidence
QUICKML_LLM_MAX_TOKENS=4096
QUICKML_LLM_TEMPERATURE=0.3

# Endpoints (from Catalyst QuickML project 47053000000046003 console)
QUICKML_LLM_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v2/project/47053000000046003/llm/chat
QUICKML_CHAT_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/47053000000046003/glm/chat
QUICKML_VISION_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/47053000000046003/vlm/chat
QUICKML_ORG_ID=60073925785                      # CATALYST-ORG header (your Zoho org id)
QUICKML_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
QUICKML_SCOPE=QuickML.deployment.READ
QUICKML_AUTH_MODE=oauth
QUICKML_ACCESS_TOKEN=                           # leave blank or paste temporary token
QUICKML_REFRESH_TOKEN=                          # leave blank or paste durable OAuth refresh token
QUICKML_API_KEY=                                # leave blank (do not store API keys here)

# ── Catalyst Cron (shared secret for endpoint auth) ───────────────────────────
CRON_SECRET_KEY=generate_a_random_32_char_string_here

# ── Catalyst Push Notifications (VAPID keys) ──────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com

# ── Bhashini (GoI ASR — Voice Tier 3) ────────────────────────────────────────
BHASHINI_API_KEY=your_bhashini_key_when_issued
BHASHINI_USER_ID=your_bhashini_user_id

# ── App Settings ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-catalyst-frontend-url
DEMO_MODE=false                                 # true = use cached demo responses
APP_PORT=8000

# ── Second Brain ─────────────────────────────────────────────────────────────
BRAIN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BRAIN_COSINE_TOP_K=5
BRAIN_SIMILARITY_THRESHOLD=0.60               # tuned for BGE (CLS pooling + normalisation)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Security posture (docs/SECURITY.md) ──────────────────────────────────────
# production = API docs hidden, HSTS on, default CRON_SECRET_KEY refused.
ANTAR_ENV=development
# Signed identity. Empty = demo header identity (anyone can claim any role).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ANTAR_AUTH_SECRET=
ANTAR_TOKEN_TTL_S=28800
# Officer accounts for POST /api/auth/login. Create them with
#   python scripts/set_password.py U-7001 Admin --name "Operations Officer"
# which writes salted hashes to ANTAR_USERS_FILE. In a container, paste that file's
# contents into ANTAR_USERS instead (one line of JSON) - nothing in the image is a credential.
ANTAR_USERS=
ANTAR_USERS_FILE=auth_users.json
# Proxies that append to X-Forwarded-For (Catalyst AppSail gateway = 1; none = 0).
ANTAR_TRUSTED_PROXY_HOPS=1
ANTAR_MAX_BODY_MB=12
ANTAR_EXPOSE_DOCS=false
# Session encryption key (Fernet). Set in production instead of the generated .session_key file.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANTAR_SESSION_KEY=

# ── Case file (agent graph checkpointer) ──────────────────────────────────────
# "sqlite" (default) keeps an officer's thread across restarts and redeploys.
# "memory" restores the old in-process saver — threads die with the process.
ANTAR_CHECKPOINT=sqlite
# Where the case file lives. Defaults to <OBS_DIR>/case_file.db. It is operational
# state, NOT part of the FIR registry, and must never be written inside main.db.
ANTAR_CHECKPOINT_DB=

# Public calendar the forecast reads festival DATES from (iCalendar). Only the date of a
# festival on a fixed list is taken from it. Leave unset for the default (India public
# holidays); set to empty to use the built-in dates only and make no outbound call.
# ANTAR_EVENT_FEED_URL=

# Which language model, if any. Unset: QuickML when its credentials are set, otherwise none.
#   quickml            Zoho Catalyst QuickML (settings below)
#   openai_compatible  any server that speaks /chat/completions, hosted or local
#                      (Ollama: ANTAR_LLM_BASE_URL=http://localhost:11434/v1  ANTAR_LLM_MODEL=<model name>)
#   none               no model; every answer comes from the records
ANTAR_LLM_PROVIDER=
ANTAR_LLM_BASE_URL=
ANTAR_LLM_API_KEY=
ANTAR_LLM_MODEL=

# What may leave the building. Unset: the endpoints configured here plus the named feature
# services (open-web search, speech, translation), each call counted. "none": nothing leaves
# and every answer comes from the records. Or a comma-separated list of hosts.
# GET /api/orchestrator/egress (Admin) shows what was called and what was refused.
ANTAR_EGRESS_ALLOW=
